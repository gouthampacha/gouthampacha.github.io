[67.683479, "o", "/lock\\/"]
[67.767154, "o", "s \\[[^]]*\\"]
[67.85007, "o", "]/lock/"]
[67.93475, "o", "; s/ \\("]
[68.022269, "o", "Request"]
[68.107287, "o", "-ID[^)"]
[68.208593, "o", "]*\\)//'"]
[69.301481, "o", "\r\n"]
[70.086633, "o", "  Failed to delete share with name or ID 'llm-models': Resource lock prevent delete action. (HTTP 403)\r\n  1 of 1 shares failed to delete.\r\n"]
[71.491575, "o", "  \u001b[2m\u21b3 blocked \u2014 a resource lock protects it while replicas are using it.\u001b[0m\r\n"]
[72.495374, "o", "\u001b[1;32madmin@cloud\u001b[0m:\u001b[1;34m~\u001b[0m\u001b[1m\u001b[1;36m$\u001b[0m o"]
