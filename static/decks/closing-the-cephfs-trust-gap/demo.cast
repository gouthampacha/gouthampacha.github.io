[23.405863, "o", "\u001b[1;32mroot@inference-01\u001b[0m:\u001b[1;34m~\u001b[0m\u001b[1m\u001b[1;36m#\u001b[0m i"]
[23.491563, "o", "p -4 r"]
[23.643306, "o", "oute\r\n"]
[24.170217, "o", "  default via 10.0.0.1 dev eth0 proto dhcp src 10.0.0.35 metric 1002 mtu 1450 \r\n  10.0.0.0/26 dev eth0 proto dhcp scope link src 10.0.0.35 metric 1002 mtu 1450 \r\n  169.254.169.254 via 10.0.0.1 dev eth0 proto dhcp src 10.0.0.35 metric 1002 mtu 1450 \r\n"]
[25.632605, "o", "\u001b[1;33m  \u21b3 no client, no key, no route to storage. Weights arrive over virtiofs.\u001b[0m\r\n"]
[27.133227, "o", "\r\n\u001b[1;36m\u001b[1m\u2501\u2501 2 \u00b7 Where the weights live \u2014 on the hypervisor \u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u001b[0m\r\n\r\n"]
[28.428671, "o", "\u001b[1;32mroot@compute-01\u001b[0m:\u001b[1;34m~\u001b[0m\u001b[1m\u001b[1;36m#\u001b[0m "]
[28.430198, "o", "mount | grep cep"]
[28.649547, "o", "h | grep -o 'n"]
[28.732823, "o", "ame=nova-[0-9a-f"]
[28.735081, "o", "]"]
[28.887545, "o", "*'\r\n"]
[29.468453, "o", "  name=nova-dbcf2b86b4422e21\r\n"]
[31.620982, "o", "  \u001b[2m\u21b3 the hypervisor holds the cephx identity; the VM holds nothing.\u001b[0m\r\n"]
[31.877599, "o", "\u001b[1;32mroot@compute-01\u001b[0m:\u001b[1;34m~\u001b[0m\u001b[1m\u001b[1;36m#\u001b[0m p"]
