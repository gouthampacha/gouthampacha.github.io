[81.842239, "o", "l 2>&1 "]
[81.934402, "o", "&\r\n"]
[83.037283, "o", "  \u001b[1;35ma load generator is serving requests off inference-01 (one line per request)\u2026\u001b[0m\r\n"]
[84.240323, "o", "\u001b[1;32madmin@cloud\u001b[0m:\u001b[1;34m~\u001b[0m\u001b[1m\u001b[1;36m$\u001b[0m "]
