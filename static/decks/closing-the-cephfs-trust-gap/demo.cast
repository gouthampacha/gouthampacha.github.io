[64.542517, "o", "\u001b[1;33m  \u21b3 one model copy, one revocable key per replica. None touch Ceph.\u001b[0m\r\n"]
[66.111517, "o", "\r\n\u001b[1;36m\u001b[1m\u2501\u2501 4 \u00b7 The registry is protected while replicas serve \u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u001b[0m\r\n\r\n"]
[66.915813, "o", "\u001b[1;32madmin@cloud\u001b[0m:\u001b[1;34m~\u001b[0m\u001b[1m\u001b[1;36m$\u001b[0m o"]
