[115.951692, "o", "  0 dropped\r\n"]
[118.234383, "o", "\r\n\u001b[1;36m\u001b[1m  Moved hosts. The model stayed mounted. Zero requests dropped.\u001b[0m\r\n"]
[119.279797, "o", "\r\n\u001b[1;36m\u001b[1m\u2501\u2501 6 \u00b7 The same boundary makes a sandbox for untrusted code \u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u001b[0m\r\n\r\n"]
[120.114619, "o", "  \u001b[1m\u001b[1;36m\u258c Why this matters beyond serving models\u001b[0m\r\n  \u001b[2m\u258c These VMs are also the ideal place to run untrusted, AI-agent-generated code.\u001b[0m\r\n  \u001b[2m\u258c The share is mounted by the HYPERVISOR, so a compromised agent holds no cephx\u001b[0m\r\n  \u001b[2m\u258c key and has no route to storage. Let's play the part and try to break out:\u001b[0m\r\n"]
[122.090961, "o", "\u001b[1;32mroot@inference-01\u001b[0m:\u001b[1;34m~\u001b[0m\u001b[1m\u001b[1;36m#\u001b[0m l"]
[122.21083, "o", "s /etc"]
[122.296716, "o", "/ceph 2>/d"]
[122.38053, "o", "ev/nul"]
[122.463252, "o", "l || ec"]
[122.545613, "o", "ho 'no"]
[122.630526, "o", " creden"]
[122.734495, "o", "tials "]
[122.82359, "o", "here'\r\n"]
[123.362228, "o", "  no credentials here\r\n"]
[124.83081, "o", "\u001b[1;32mroot@inference-01\u001b[0m:\u001b[1;34m~\u001b[0m\u001b[1m\u001b[1;36m#\u001b[0m "]
[124.919184, "o", "find / -xdev"]
[125.009606, "o", " -name "]
[125.094392, "o", "'*.keyr"]
[125.178518, "o", "ing' -"]
[125.262949, "o", "o -name"]
[125.354645, "o", " 'ceph"]
[125.445537, "o", ".conf' "]
[125.530383, "o", "2>/dev"]
[125.615074, "o", "/null |"]
[125.698488, "o", " wc -l"]
