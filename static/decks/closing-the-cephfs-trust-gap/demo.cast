[56.950406, "o", "  support-bot-v3\r\n"]
[58.583694, "o", "  \u001b[2mEach replica got its own cephx identity (operator view):\u001b[0m\r\n"]
[60.370186, "o", "\u001b[1;32madmin@cloud\u001b[0m:\u001b[1;34m~\u001b[0m\u001b[1m\u001b[1;36m$\u001b[0m o"]
