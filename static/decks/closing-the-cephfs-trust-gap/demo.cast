[19.527086, "o", "  NONE\r\n"]
[20.931278, "o", "\u001b[1;32mroot@inference-01\u001b[0m:\u001b[1;34m~\u001b[0m\u001b[1m\u001b[1;36m#\u001b[0m l"]
