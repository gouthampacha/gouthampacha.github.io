[131.854832, "o", "  default via 10.0.0.1 dev eth0 proto dhcp src 10.0.0.35 metric 1002 mtu 1450 \r\n  10.0.0.0/26 dev eth0 proto dhcp scope link src 10.0.0.35 metric 1002 mtu 1450 \r\n  169.254.169.254 via 10.0.0.1 dev eth0 proto dhcp src 10.0.0.35 metric 1002 mtu 1450 \r\n"]
[133.337041, "o", "\u001b[1;33m  \u21b3 no key, no route to storage \u2014 a jailbroken agent's blast radius is one directory.\u001b[0m\r\n"]
[135.398757, "o", "\r\n\u001b[1;36m\u001b[1m  Untrusted code in. Nothing sensitive out \u2014 the primitive Kata already trusts.\u001b[0m\r\n"]
[138.277347, "o", "\u001b[2m  One mount on the host, many isolated VMs, zero Ceph exposure \u2014 on OpenStack.\u001b[0m\r\n"]
