[36.050602, "o", ">/g'\r\n"]
[38.333638, "o", "  \tcaps mds = \"allow rw path=/volumes/_nogroup/<id>/<id>\"\r\n  \tcaps mon = \"allow r\"\r\n  \tcaps osd = \"allow rw pool=cephfs.cephfs.data namespace=fsvolumens___nogroup_<id>\"\r\n"]
[39.727937, "o", "\u001b[1;33m  \u21b3 that key is scoped to one path + namespace. Least privilege.\u001b[0m\r\n"]
[41.330603, "o", "\r\n\u001b[1;36m\u001b[1m\u2501\u2501 3 \u00b7 Scale out \u2014 a new replica serves instantly \u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u001b[0m\r\n\r\n"]
[42.142547, "o", "  \u001b[2mTraffic spikes. inference-02 mounts the SAME registry \u2014 no 140 GB copy.\u001b[0m\r\n"]
[43.145971, "o", "\u001b[1;32mroot@inference-02\u001b[0m:\u001b[1;34m~\u001b[0m\u001b[1m\u001b[1;36m#\u001b[0m l"]
[43.230579, "o", "s /mnt"]
[43.314834, "o", "/models"]
