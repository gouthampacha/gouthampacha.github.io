[81.045922, "o", "-u +%T "]
[81.133738, "o", ">>/mnt/"]
[81.219529, "o", "models"]
[81.315495, "o", "/reques"]
[81.399406, "o", "ts.log;"]
[81.482508, "o", " sleep "]
[81.566755, "o", ".5; do"]
[81.650624, "o", "ne' >/d"]
