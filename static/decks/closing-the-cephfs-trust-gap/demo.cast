[7.802263, "o", "\u001b[H\u001b[2J\u001b[3J\u001b[1mServing an open LLM at scale on OpenStack\u001b[0m\r\n\u001b[2mMany inference replicas, one copy of the weights \u2014 and no VM ever touches Ceph.\u001b[0m\r\n"]
[9.3385, "o", "\r\n\u001b[1;36m\u001b[1m\u2501\u2501 1 \u00b7 An inference server backed by a shared model registry \u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u001b[0m\r\n\r\n"]
[10.142751, "o", "  \u001b[2minference-01 serves Llama-3-70B; its weights come from a Manila share.\u001b[0m\r\n"]
[11.147074, "o", "\u001b[1;32madmin@cloud\u001b[0m:\u001b[1;34m~\u001b[0m\u001b[1m\u001b[1;36m$\u001b[0m "]
[11.230424, "o", "opensta"]
[11.314875, "o", "ck ser"]
[11.398813, "o", "ver sha"]
[11.494239, "o", "re list "]
[11.585424, "o", "infere"]
[11.671044, "o", "nce-01\r\n"]
[13.68279, "o", "  +--------------------------------------+--------+--------+\r\n  | Share ID                             | Status | Tag    |\r\n  +--------------------------------------+--------+--------+\r\n  | 4ef06d10-e85f-4793-9949-8904ea2e17d1 | active | models |\r\n  +--------------------------------------+--------+--------+\r\n"]
[15.054465, "o", "\u001b[1;32mroot@inference-01\u001b[0m:\u001b[1;34m~\u001b[0m\u001b[1m\u001b[1;36m#\u001b[0m "]
