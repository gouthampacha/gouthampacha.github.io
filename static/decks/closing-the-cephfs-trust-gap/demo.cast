[15.256004, "o", "/model"]
[15.342509, "o", "s/llama-3-"]
[15.427225, "o", "70b\r\n"]
[15.983832, "o", "  config.json\r\n  generation_config.json\r\n  model-00001-of-00002.safetensors\r\n  model-00001-of-00002.safetensors.sha256\r\n  model-00002-of-00002.safetensors\r\n  model.safetensors.index.json\r\n  tokenizer.json\r\n  tokenizer_config.json\r\n"]
[17.552239, "o", "\u001b[1;33m  \u21b3 the model is right there. What does this VM know about Ceph?\u001b[0m\r\n"]
[18.402468, "o", "\u001b[1;32mroot@inference-01\u001b[0m:\u001b[1;34m~\u001b[0m\u001b[1m\u001b[1;36m#\u001b[0m w"]
