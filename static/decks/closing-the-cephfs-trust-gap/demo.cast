[76.68355, "o", "\u001b[1;33m  \u21b3 the SAME list, as a tenant: cephx identity and key are masked.\u001b[0m\r\n"]
[78.419765, "o", "\r\n\u001b[1;36m\u001b[1m\u2501\u2501 5 \u00b7 Live-migrate a serving replica \u2014 zero dropped requests \u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u001b[0m\r\n\r\n"]
[80.573905, "o", "\u001b[1;32mroot@inference-01\u001b[0m:\u001b[1;34m~\u001b[0m\u001b[1m\u001b[1;36m#\u001b[0m n"]
[80.658905, "o", "ohup s"]
[80.790742, "o", "h -c '"]
[80.876434, "o", "while :; do"]
