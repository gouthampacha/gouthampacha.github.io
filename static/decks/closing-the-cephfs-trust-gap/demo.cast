[32.414079, "o", "\r\n"]
[33.079959, "o", "  /usr/libexec/virtiofsd --fd=38 --shared-dir /var/lib/nova/mnt/071a45c42ef584588f588dd84a772873\r\n"]
[34.445967, "o", "\u001b[1;32mroot@compute-01\u001b[0m:\u001b[1;34m~\u001b[0m\u001b[1m\u001b[1;36m#\u001b[0m "]
